{
    "productName": "Transkribator",
    "version": "0.1.0",
    "identifier": "com.transkribator.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Transkribator",
                "width": 1200,
                "height": 800,
                "minWidth": 900,
                "minHeight": 620,
                "resizable": true,
                "decorations": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-eval'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
        "resources": [
            "../python/fw_worker.py",
            "../python/exporters.py"
        ],
        "linux": {
            "appimage": {
                "bundleMediaFramework": true
            }
        }
    }
}